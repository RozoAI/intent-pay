{
  "extends": "@tsconfig/node20/tsconfig.json",
  "compilerOptions": {
    // ponytail: node16 resolution treats viem>=2.28 (_types is {"type":"module"}) as
    // ESM-only, breaking CJS imports. Classic "node" resolution ignores it.
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "outDir": "dist",
    "declaration": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts"]
}
